# ══════════════════════════════════════════════
# BingX Trading Bot — Настройки
# Скопируй этот файл в .env и заполни значения
# ══════════════════════════════════════════════

# BingX API (получить на: https://bingx.com/en-us/account/api)
BINGX_API_KEY=твой_api_ключ_сюда
BINGX_SECRET_KEY=твой_secret_ключ_сюда

# Telegram
# 1. Создай бота у @BotFather в Telegram
# 2. Получи токен
# 3. Напиши боту /start и узнай chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=токен_от_botfather
TELEGRAM_CHAT_ID=твой_chat_id
